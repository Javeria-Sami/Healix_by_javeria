# ==============================================================================
# Healix Platform Environment Configuration Template
# ==============================================================================
# Security Notice:
# 1. Never commit active secrets, credentials, or private keys to version control.
# 2. Copy this file to .env or .env.local for local development.
# 3. In production, configure environment variables via your cloud host / secrets manager.
# ==============================================================================

# Server Environment (Server-only)
NODE_ENV=development
PORT=5000
CORS_ORIGIN=http://localhost:5173

# Client Environment (Public / Bundled via Vite)
# Note: Variables prefixed with VITE_ are exposed to the client-side JavaScript bundle.
VITE_API_URL=/api
VITE_APP_NAME="Healix Healthcare"
VITE_BASE_URL="https://healix.health"
